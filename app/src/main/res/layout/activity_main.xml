<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="48dp" android:gravity="center_vertical" android:background="#090F1B">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VERT TV" android:textSize="42sp" android:textColor="#46E0A6"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your screen. Your world." android:textSize="28sp" android:textColor="#FFFFFF" android:layout_marginTop="12dp"/>
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Enter your email to sign in or activate your TV." android:textSize="20sp" android:layout_marginTop="24dp" android:textColor="#BCC8D8"/>
<EditText android:id="@+id/email" android:layout_width="480dp" android:layout_height="64dp" android:inputType="textEmailAddress" android:singleLine="true" android:hint="Email address" android:textColor="#FFFFFF" android:textColorHint="#BCC8D8" android:background="@drawable/focus_card" android:layout_marginTop="24dp"/>
<EditText android:id="@+id/activation_code" android:layout_width="480dp" android:layout_height="64dp" android:inputType="textPassword" android:singleLine="true" android:hint="Private activation code" android:visibility="gone" android:textColor="#FFFFFF" android:textColorHint="#BCC8D8" android:background="@drawable/focus_card" android:layout_marginTop="16dp"/>
<Button android:id="@+id/activate" android:layout_width="480dp" android:layout_height="64dp" android:text="Continue" android:background="@drawable/focus_card" android:textColor="#FFFFFF" android:layout_marginTop="16dp"/>
</LinearLayout>
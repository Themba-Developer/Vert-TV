{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vert-tv",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vert-tv",
      "database_id": "edca86d8-b63e-43bb-9ee9-20a30c2da1c9",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MOVIES",
      "bucket_name": "vert-tv-movies"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://vert-tv.mahlangu843.workers.dev",
    "PAYFAST_SANDBOX": "false",
    "CATALOGUE_SOURCE": "dulo"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
